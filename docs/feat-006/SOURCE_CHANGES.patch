+    throw Object.assign(new Error('Chưa cấu hình lưu ảnh. Bạn vẫn có thể gửi bài dạng chữ.'), { status: 503 });
+  const client = new AwsClient({ accessKeyId, secretAccessKey, region: 'auto', service: 's3', retries: 0 });
