+ if not exists(select 1 from vault.decrypted_secrets where name='feat006_project_url' and decrypted_secret ~ '^https://[^/]+[.]supabase[.]co$')
+ or not exists(select 1 from vault.decrypted_secrets where name='feat006_cleanup_secret' and length(decrypted_secret)>=32)
+ then raise exception 'Configure FEAT-006 Vault secrets first';end if;
