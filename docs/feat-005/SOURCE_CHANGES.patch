+specs={name:hashlib.sha256((out/name).read_bytes()).hexdigest() for name in ['FINAL_SPEC_SYSTEM_ACTOR_RESOLVED.md','DECISIONS_UPDATE_SYSTEM_ACTOR_RESOLVED.md']}
