+}
+const checks=[
+ ['database',['--test','tests/feat-005/*.test.mjs'],{}],
+ ['legacy-database',['--test','tests/homework/*.test.mjs','tests/feat-002/*.test.mjs'],{FEAT002_UPGRADE:'1',FEAT004_UPGRADE:'1'}],
